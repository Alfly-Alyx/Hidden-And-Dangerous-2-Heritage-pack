PROFILE=LOCAL_GUARDS_CARNAGE
  status=BLOCKED
  reason=no dedicated behavior or equivalent neighboring contract

PROMOTION_GATES
  exact_transforms_validated_in_world
  signal1_is_monostable
  no_route_lookup
  no_blocked_door_or_corridor
  normal_save_reload_passes

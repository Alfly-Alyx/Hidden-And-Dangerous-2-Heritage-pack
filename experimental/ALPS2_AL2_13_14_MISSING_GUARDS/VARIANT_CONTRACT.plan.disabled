PROFILE=RELEASE
  bind_AL2_13_A1=false
  create_AL2_13=false
  create_AL2_14=false

PROFILE=LOCAL_GUARDS_NORMAL_TEST
  create_AL2_13=true          # DEDUCTION from AL2_15
  create_AL2_14=true          # DEDUCTION from AL2_16

// FILE: ge_01.scr
// OFFICIEL : reactivation de la ligne commentee a son emplacement exact.
OnDeath()
{
SendSignal (starterforge40,1);
SendSignal (piskac,1);
SaveGameValue(21, 0);
EndScript();
}

